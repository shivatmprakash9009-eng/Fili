# Server-side URL for the existing Fili Python API.
# Keep this value server-only; never prefix it with NEXT_PUBLIC_.
# Example local value: http://127.0.0.1:8000
FILI_API_BASE_URL=
# Required for production API access. Use the same value on the Python server.
FILI_API_TOKEN=

# Firebase Web App configuration (public client values; never put service-account keys here).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
