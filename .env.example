# ─── LLM Configuration ────────────────────────────────────────
# Provider: "groq" (Ultra-fast LPU), "openai", "grok" (xAI), or "gemini"
LLM_PROVIDER=groq
# Get free key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here
LLM_API_KEY=gsk_your-groq-api-key-here
# Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, deepseek-r1-distill-llama-70b
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30
# Optional custom endpoint (default: https://api.groq.com/openai/v1/chat/completions)
LLM_BASE_URL=

# ─── Live Data Integrations ──────────────────────────────────
# Apollo.io API Key (https://app.apollo.io/#/settings/integrations/api_keys)
APOLLO_API_KEY=
# SerpAPI Key (https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=

# ─── Email / SMTP Configuration ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com

# ─── Agent Settings ──────────────────────────────────────────
AGENT_MAX_RETRIES=3
AGENT_RETRY_DELAY=1.0
AGENT_TIMEOUT=60
AGENT_HEARTBEAT=30

# ─── Campaign Settings ──────────────────────────────────────
DAILY_EMAIL_LIMIT=50
FOLLOW_UP_DELAY=3
MAX_FOLLOW_UPS=3
SENDER_NAME=Your Name

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# ─── Daily Prospector (opt-in; single dashboard process) ──────────────
FILI_DAILY_PROSPECTOR_ENABLED=false
FILI_DAILY_PROSPECTOR_TIME=09:00
FILI_DAILY_PROSPECTOR_TIMEZONE=Asia/Kolkata
FILI_DAILY_PROSPECTOR_TARGET=SaaS companies
FILI_DAILY_PROSPECTOR_LOCATION=India
FILI_DAILY_PROSPECTOR_MAX_LEADS=10

# Shared server-side API token. Set the same secret in frontend and backend deployments.
# Required when dashboard.py binds beyond localhost.
FILI_API_TOKEN=
